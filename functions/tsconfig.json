{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "outDir": "lib",
    "sourceMap": true,
    "strict": true,
    "target": "ES2022",         // Upgraded from es2017 for better Node 24 support
    "skipLibCheck": true,      // Essential to ignore those 68 errors in node_modules
    "lib": ["ES2022", "DOM"]   // Ensures basic environment types are loaded
  },
  "compileOnSave": true,
  "include": [
    "src"
  ]
}
