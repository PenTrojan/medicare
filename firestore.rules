rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  
    // 4. Give admin full access
    // Helper function to check if the user is an admin
    function isAdmin() {
      return request.auth != null && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Global Admin Access: The {document=**} wildcard matches every document
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // 1. Rules for Users Collection
    match /users/{userId} {
      // Allow users to read their own profile
      allow read: if request.auth != null && request.auth.uid == userId;

      // Creation Rule: Allow Seeker or Assistant only
      allow create: if request.auth != null && request.auth.uid == userId
                    && (request.resource.data.role == 'seeker' || request.resource.data.role == 'assistant');

      // Update Rule: Prevent users from changing their own role to 'admin'
      allow update: if request.auth != null && request.auth.uid == userId
                    && request.resource.data.role == resource.data.role 
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);
      
      // Seekers can read Assistant profiles
      allow read: if request.auth != null && 
                  get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'seeker';

      // Rules for the 'bookings' subcollection
      match /bookings/{bookingId} {
        // Allows the specific user to read and listen to their scheduled shifts
        allow read: if request.auth != null && request.auth.uid == userId;
        // Adjust write permissions based on your backend logic (e.g., if Cloud Functions handle it, leave as false)
        allow write: if false; 
      }

      // Rules for the 'invitations' subcollection
      match /invitations/{invitationId} {
        // Allows the specific user to check their personal pending dashboard offers
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // 2. Rules for the Metadata Collection
    match /metadata/{document} {
      // Allows any logged-in user to read the skills list
      allow read: if request.auth != null;
      
      // Only the Admin should be able to write to this from the console
      allow write: if false; 
    }
    
    // 3. Rules for the Jobs Collection
    match /jobs/{jobId} {
      allow read, write: if request.auth != null;
    }

    // 4. Rules for Chats
    match /chat_rooms/{roomId} {
      // READ: Allow if the user is authenticated AND (the room doesn't exist yet OR they are a participant)
      allow read: if request.auth != null && 
        (resource == null || request.auth.uid == resource.data.seekerId || request.auth.uid == resource.data.assistantId);

      // WRITE: Allow if the authenticated user is setting themselves as either the seeker or assistant
      allow write: if request.auth != null && 
        (request.auth.uid == request.resource.data.seekerId || request.auth.uid == request.resource.data.assistantId);

      // Messages Subcollection
      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }
    // 5. Rules for the Invitations Collection
    match /invitations/{inviteId} {
      // READ: Allow Seeker to fetch the document by Composite ID
      allow get: if request.auth != null; 
      
      // LIST: Restrict visibility so users only see their own invitations
      allow list: if request.auth != null && 
        (request.auth.uid == resource.data.seekerId || request.auth.uid == resource.data.assistantId);
      
      // UPDATE: Permissions are now role-specific.
      allow update: if request.auth != null && (
        (request.auth.uid == resource.data.assistantId && 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
      );

      // CREATE/DELETE: Strictly blocked for clients.
      allow create, delete: if false; 
    }

    // =========================================================================
    // NEW: 6. Rules for the Bills (Billing Ledger) Collection
    // =========================================================================
    match /bills/{billId} {
      // Allow read operations only if the participant is bound to the metadata
      allow read: if request.auth != null && 
        (request.auth.uid == resource.data.metadata.seekerId || 
         request.auth.uid == resource.data.metadata.assistantId);
      
      // LOCKOUT: Prevent clients from executing updates, changes, or injections
      allow write: if false; 
    }
  }
}
